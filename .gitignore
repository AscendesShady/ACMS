
.venv/
__pycache__/
*.pyc
*.pdf
.claude/

# Reference material and records stay local; only the UI rulebook (AGENTS.md requires it) and the routing file go in
references/*
!references/CONTEXT.md
!references/ui-ux-design-rulebook.md
reports/
*.egg-info/
tools/eval_commands.json

# Stage outputs are per run: kept for review, not in git
stages/*/*/output/*
!stages/*/*/output/.gitkeep

# (The SUMO source checkout, eclipse-sumo/sumo, lives in references/sumo/: ignored with the rest of references/)

# Graphitout editor workspace (local state)
.graphitout/
